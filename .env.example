# 複製此檔為 .env 並修改成你的設定
# cp .env.example .env

# ─────────── 環境模式 ───────────
NODE_ENV=production

# ─────────── PostgreSQL ───────────
POSTGRES_DB=audit_db
POSTGRES_USER=audit_user
# ⚠️ 請改成強密碼（>=12 字元，含大小寫數字符號）
POSTGRES_PASSWORD=AuditServer2026!Strong#

# ─────────── Node.js App ───────────
# 對外開放的 port（內網連線用）
APP_PORT=3000

# ⚠️ JWT 密鑰：請改成 32+ 字元的隨機字串
# 可用 openssl rand -hex 32 產生
JWT_SECRET=change-this-to-a-random-32-char-string-please-do-not-use-default

# 預設管理員密碼（首次啟動時建立 admin 帳號）
# 建立後請立刻登入修改
ADMIN_INITIAL_PASSWORD=admin123
